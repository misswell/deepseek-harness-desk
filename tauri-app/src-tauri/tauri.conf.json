{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Desk",
  "version": "0.3.24",
  "identifier": "com.deepseek.harnessdesk",
  "mainBinaryName": "deepseek-harness-desk",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness Desk",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "shadow": true,
        "resizable": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
